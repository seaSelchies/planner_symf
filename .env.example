# Copy this file to .env and fill in the values. .env is not tracked.
#
#   cp .env.example .env
#
# Every value below is read through %env(...)% in config/packages/. Nothing is
# hardcoded in PHP or YAML, and there are no literal fallbacks (invariant 6).

APP_ENV=dev
APP_SECRET=

# The database the application talks to. docker compose up -d database starts
# one; compose.yaml decides the credentials it starts with.
DATABASE_USER=app
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=app

# Used when a command builds a URL with no incoming request behind it.
DEFAULT_URI=http://localhost:8000

MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=sync://

# Where the dump() server listens. Leave empty to print to the output instead.
VAR_DUMPER_SERVER=
